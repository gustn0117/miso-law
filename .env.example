# Admin login password
ADMIN_PASSWORD=changeme1234

# (선택) OpenAI API. 키워드 매칭 우선 — 카테고리가 잡혔을 때만 보조 호출.
# 비워두면 LLM 호출 없이 카테고리별 기본 안내문만 출력 (사이트는 정상 동작).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# (선택) 상담 접수 시 운영자 이메일 알림. 모두 채워야 발송됨.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# (선택) 상담 접수 시 운영자 SMS 알림 (Solapi · CoolSMS)
# 4개 모두 채워야 발송됨. 90byte 초과 시 자동 LMS 전환.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM=01098857010
SOLAPI_TO_ADMIN=

# (선택) 외부 링크 기본값(관리자 페이지에서 덮어쓸 수 있음)
DEFAULT_CAFE_URL=https://cafe.naver.com/example
DEFAULT_SHORTS_URL=https://www.youtube.com/@example/shorts
DEFAULT_KAKAO_URL=https://pf.kakao.com/example
